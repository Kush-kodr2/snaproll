@base = http://localhost:8000

### 1. create the first admin (works only once)
POST {{base}}/auth/bootstrap
Content-Type: application/json

{"name": "Your Name", "email": "you@example.com", "password": "at-least-8-chars"}

### 2. log in
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{"email": "you@example.com", "password": "at-least-8-chars"}

### 3. create a batch
POST {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"name": "CSE 3rd Year 5th sem", "year": 3, "section": "A"}

### 4. list batches
GET {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}

### A. find the batch id
# @name batches
GET {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}

### B. create a teacher account (admin only)
# @name teacher
POST {{base}}/auth/teachers
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"name": "Test Teacher", "email": "teacher@example.com", "password": "teacher-pass-1"}

### C. create a course
# @name course
POST {{base}}/courses
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"code": "CS303", "name": "IWT"}

### D. create an offering (teacher teaches course to batch)
# @name offering
POST {{base}}/offerings
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"course_id": {{course.response.body.id}}, "teacher_id": {{teacher.response.body.id}}, "batch_id": {{batches.response.body.$[0].id}}}

### E. add students (send once per student, change the numbers and names)
POST {{base}}/students
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"enrollment_no": "0101CS231062", "name": "Kushal", "batch_id": {{batches.response.body.$[0].id}}}

### F. list students
GET {{base}}/students?batch_id={{batches.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.access_token}}

### G. log in as the teacher
# @name tlogin
POST {{base}}/auth/login
Content-Type: application/json

{"email": "teacher@example.com", "password": "teacher-pass-1"}

### H. teacher lists their offerings
GET {{base}}/offerings
Authorization: Bearer {{tlogin.response.body.access_token}}

### I. teacher creates a session
# @name session
POST {{base}}/sessions
Authorization: Bearer {{tlogin.response.body.access_token}}
Content-Type: application/json

{"offering_id": {{offering.response.body.id}}, "session_date": "2026-10-19"}

### J. see the pre-created attendance rows
GET {{base}}/sessions/{{session.response.body.id}}/attendance
Authorization: Bearer {{tlogin.response.body.access_token}}

### K. teacher tries to create a course (expect 403)
POST {{base}}/courses
Authorization: Bearer {{tlogin.response.body.access_token}}
Content-Type: application/json

{"code": "CS999", "name": "Should Fail"}