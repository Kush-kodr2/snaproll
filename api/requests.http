@base = http://localhost:8000

### 1. create the first admin (works only once)
POST {{base}}/auth/bootstrap
Content-Type: application/json

{"name": "Your Name", "email": "you@example.com", "password": "at-least-8-chars"}

### 2. log in
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{"email": "you@example.com", "password": "at-least-8-chars"}

### 3. create a batch
POST {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"name": "CSE 3rd Year 6th sem", "year": 3, "section": "B"}

### 4. list batches
GET {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}

### A. find the batch id
# @name batches
GET {{base}}/batches
Authorization: Bearer {{login.response.body.access_token}}

### B. create a teacher account (admin only)
# @name teacher
POST {{base}}/auth/teachers
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"name": "Test Professor 1", "email": "teacher1233@example.com", "password": "abcd1234"}

### C. create a course
# @name course
POST {{base}}/courses
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"code": "CS502", "name": "Database management system"}

### D. create an offering (teacher teaches course to batch)
# @name offering
POST {{base}}/offerings
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"course_id": {{course.response.body.id}}, "teacher_id": {{teacher.response.body.id}}, "batch_id": {{batches.response.body.$[0].id}}}

### E. add students (send once per student, change the numbers and names)
POST {{base}}/students
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: application/json

{"enrollment_no": "0101CS231062", "name": "kushal", "batch_id": {{batches.response.body.$[0].id}}}

### F. list students
GET {{base}}/students?batch_id={{batches.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.access_token}}

### G. log in as the teacher
# @name tlogin
POST {{base}}/auth/login
Content-Type: application/json

{"email": "teacher1233@example.com", "password": "abcd1234"}

### H. teacher lists their offerings
GET {{base}}/offerings
Authorization: Bearer {{tlogin.response.body.access_token}}

### I. teacher creates a session
# @name session
POST {{base}}/sessions
Authorization: Bearer {{tlogin.response.body.access_token}}
Content-Type: application/json

{"offering_id": {{offering.response.body.id}}, "session_date": "2026-10-19"}

### J. see the pre-created attendance rows
GET {{base}}/sessions/{{session.response.body.id}}/attendance
Authorization: Bearer {{tlogin.response.body.access_token}}

### K. teacher tries to create a course (expect 403)
POST {{base}}/courses
Authorization: Bearer {{tlogin.response.body.access_token}}
Content-Type: application/json

{"code": "CS999", "name": "Should Fail"}
### admin: generate invite codes (use your batch id)
POST {{base}}/batches/7/invite-codes
Authorization: Bearer {{login.response.body.access_token}}

### admin: check the Go to Python link
POST {{base}}/tools/analyze
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="group_far.jpg"
Content-Type: image/jpeg


< ../data/known/group_far.jpg
--WebAppBoundary--

### withdraw
POST {{base}}/enroll/withdraw
Content-Type: application/json

{"enrollment_no": "0101CS231062", "withdraw_code": "63AV44UJAB"}

### teacher gets the to be review faces (cropped)
GET {{base}}/sessions/4/review
Authorization: Bearer {{tlogin.response.body.access_token}}

### teacher decides on one student
PUT {{base}}/sessions/4/attendance/11
Authorization: Bearer {{tlogin.response.body.access_token}}
Content-Type: application/json

{"status": "absent"}

### close the session
POST {{base}}/sessions/4/close
Authorization: Bearer {{tlogin.response.body.access_token}}

### admin deletes the student's face data
DELETE {{base}}/students/16/face-data
Authorization: Bearer {{login.response.body.access_token}}

### fresh invite code for just this student
POST {{base}}/students/16/invite-code
Authorization: Bearer {{login.response.body.access_token}}